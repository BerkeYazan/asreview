{
  "manifest_version": 3,
  "name": "ASReview Full-Text Companion",
  "version": "1.0",
  "description": "Read full-text papers on publisher websites and sync your tags with ASReview LAB",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "cookies",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:5000/*",
    "https://localhost:*/*",
    "*://*/*.pdf",
    "*://*/*.pdf?*",
    "*://*/*pdf*",
    "file://*.pdf",
    "file://*/*.pdf",

    "*://*/pdf/*",
    "*://*/*/pdf/*",
    "*://*/*.PDF",
    "*://*.doi.org/*",
    "*://*.pubmed.ncbi.nlm.nih.gov/*"
  ],
  "externally_connectable": {
    "matches": [
      "*://localhost:*/*",
      "http://localhost:5000/*",
      "http://localhost:3000/*",
      "https://localhost:*/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "*://*/*.pdf",
